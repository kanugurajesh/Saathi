# ---- LLM: Gemini 2.5 Flash. Leave both blank to run on the deterministic engine. ----
# Option A - Vertex AI (HextGen's stack): gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Option B - AI Studio key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Retries on 429/5xx: max attempts and total seconds one call may wait before falling back
LLM_MAX_RETRIES=3
LLM_RETRY_BUDGET_S=30

# ---- Storage: blank = in-memory mongomock ----
MONGODB_URI=
# MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=hextgen_automation

# ---- Portal automation ----
PORTAL_BASE_URL=http://127.0.0.1:8100
PLAYWRIGHT_HEADLESS=true
OTP_AUTO_WAIT_S=6
OTP_HUMAN_WAIT_S=120
SYNC_INTERVAL_MINUTES=0

# ---- SLAs (minutes) ----
SLA_PREAUTH_MIN=60
SLA_DISCHARGE_MIN=180
SLA_QUERY_REPLY_MIN=120

# ---- Alerts (Slack / Google Chat incoming webhook) ----
ALERT_WEBHOOK_URL=

# ---- Receivables: daily WhatsApp summary (Meta WhatsApp Cloud API). Blank token = dry run to the outbox. ----
HOSPITAL_NAME=Godavari Demo Multispeciality Hospital, Nalgonda
DASHBOARD_URL=http://127.0.0.1:8000/#receivables
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OWNER_TO=
WHATSAPP_TEMPLATE=receivables_daily_summary
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v23.0
# Daily send time in IST (HH:MM); blank = only when "Send now" is pressed
RECEIVABLES_SUMMARY_AT=
